---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nobori - あなたのビジネスを次のステージへ。ホームページ制作・Webサイト構築をスピーディにお届けします。" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="あなたのビジネスを次のステージへ。ホームページ制作をスピーディにお届け。" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #5b8c6e;
    --color-primary-light: #7bab8e;
    --color-primary-dark: #3d6b4f;
    --color-accent: #e8a87c;
    --color-bg: #faf8f5;
    --color-bg-card: #ffffff;
    --color-text: #2c2c2c;
    --color-text-light: #6b6b6b;
    --color-border: #e8e4df;
    --font-ja: 'Noto Sans JP', sans-serif;
    --font-en: 'Outfit', sans-serif;
    --max-width: 1080px;
    --section-padding: 5rem 1.5rem;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-ja);
    color: var(--color-text);
    background-color: var(--color-bg);
    line-height: 1.8;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>
