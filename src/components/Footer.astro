---
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-logo-row">
          <svg class="logo-mark" width="24" height="24" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 30 L18 6 L30 30" stroke="var(--color-primary-light)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M12 30 L18 16 L24 30" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span class="logo-text">Nobori</span>
        </div>
        <p class="footer-tagline">ビジネスを次のステージへ。ホームページ制作</p>
      </div>
      <div class="footer-links">
        <a href="#service">サービス</a>
        <a href="#plan">料金プラン</a>
        <a href="#flow">制作の流れ</a>
        <a href="#works">制作実績</a>
        <a href="#contact">お問い合わせ</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {year} Nobori. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    background: rgba(0, 0, 0, 0.3);
    color: #ccc;
    padding: 3rem 1.5rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-logo-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-text {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 1.3rem;
    color: #fff;
  }

  .footer-tagline {
    font-size: 0.8rem;
    color: #999;
    margin-top: 0.25rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-size: 0.85rem;
    color: #999;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: #fff;
  }

  .footer-bottom p {
    font-size: 0.8rem;
    color: #666;
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
      gap: 1.5rem;
    }

    .footer-links {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
